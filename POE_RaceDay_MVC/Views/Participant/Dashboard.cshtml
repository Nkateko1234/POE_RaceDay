@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">
    <h1>Participant Dashboard</h1>

    <p class="text-muted">
        Welcome to RaceDay. Discover races and track your progress.
    </p>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Upcoming Events</h5>
                <p>Explore available races and events.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>My Enrolments</h5>
                <p>View the events you have joined.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>My Results</h5>
                <p>View your race history and results.</p>
            </div>
        </div>
    </div>

    <p class="mt-4">
        Logged-in User ID: @ViewBag.UserID
    </p>
</div>