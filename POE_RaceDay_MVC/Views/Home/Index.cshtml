@{
    ViewData["Title"] = "Home Page";

    int? userID = Context.Session.GetInt32("UserID");
    string? role = Context.Session.GetString("Role");
}

<!-- HERO SECTION -->
<div class="raceday-home-hero text-center">

    <h1 class="display-1 fw-bold">
        RACEDAY<span class="raceday-dot">.</span>
    </h1>

    <h2 class="fw-bold mb-4">
        PUSH YOUR LIMITS.
        <br />
        OWN YOUR RACE.
    </h2>

    <p class="lead">
        Discover exciting running events, challenge yourself
        and become part of the RaceDay community.
    </p>

    <div class="mt-4">

        @if (userID == null)
        {
            <a asp-controller="Auth"
               asp-action="Register"
               class="btn raceday-main-button btn-lg me-2">
                REGISTER NOW
            </a>

            <a asp-controller="Auth"
               asp-action="Login"
               class="btn btn-outline-dark btn-lg">
                LOGIN
            </a>
        }
        else if (role == "Organiser")
        {
            <a asp-controller="Organiser"
               asp-action="Dashboard"
               class="btn raceday-main-button btn-lg">
                ORGANISER DASHBOARD
            </a>
        }
        else
        {
            <a asp-controller="Participant"
               asp-action="Events"
               class="btn raceday-main-button btn-lg">
                EXPLORE EVENTS
            </a>
        }

    </div>

</div>


<!-- FEATURE SECTION -->
<section class="raceday-feature-section">

    <div class="container">

        <h2 class="features-heading text-center">
            <span class="heading-black">MORE</span>
            <span class="heading-green">THAN JUST</span>
            <span class="heading-lime">A RACE.</span>
        </h2>

        <div class="row g-4">

            <!-- DISCOVER -->
            <div class="col-md-4">

                <div class="feature-card discover-card">

                    <h3>01.</h3>

                    <h4>DISCOVER</h4>

                    <img src="~/images/discover.jpg"
                         alt="Runner discovering a race route"
                         class="feature-image" />

                    <p>Find events.</p>

                </div>

            </div>

            <!-- COMPETE -->
            <div class="col-md-4">

                <div class="feature-card compete-card">

                    <h3>02.</h3>

                    <h4>COMPETE</h4>

                    <img src="~/images/compete.png"
                         alt="Runners competing in a marathon"
                         class="feature-image" />

                    <p>Take the challenge.</p>

                </div>

            </div>

            <!-- ACHIEVE -->
            <div class="col-md-4">

                <div class="feature-card achieve-card">

                    <h3>03.</h3>

                    <h4>ACHIEVE</h4>

                    <img src="~/images/achieve.jpg"
                         alt="Runner celebrating at the finish line"
                         class="feature-image" />

                    <p>Own your results.</p>

                </div>

            </div>

        </div>

    </div>

</section>