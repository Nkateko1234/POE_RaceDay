@model POE_RaceDay_MVC.Models.CaptureResultViewModel

@{
    ViewData["Title"] = "Capture Result";
}

<div class="container mt-5">

    <h2 class="fw-bold">Capture Race Result</h2>

    <p class="text-muted">
        Record the participant's finishing time and position.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow p-4 mt-4">

        <form asp-action="CaptureResult" method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="EnrollmentID" class="form-label">
                    Enrolment ID
                </label>

                <input asp-for="EnrollmentID"
                       class="form-control"
                       readonly />

                <span asp-validation-for="EnrollmentID"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FinishTime" class="form-label">
                    Finish Time (HH:MM:SS)
                </label>

                <input asp-for="FinishTime"
                       type="time"
                       step="1"
                       class="form-control" />

                <span asp-validation-for="FinishTime"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Position" class="form-label">
                    Finishing Position
                </label>

                <input asp-for="Position"
                       type="number"
                       min="1"
                       class="form-control" />

                <span asp-validation-for="Position"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn raceday-button">
                Save Result
            </button>

            <a asp-controller="Organiser"
               asp-action="Dashboard"
               class="btn btn-outline-dark">
                Cancel
            </a>

        </form>

    </div>
</div>
