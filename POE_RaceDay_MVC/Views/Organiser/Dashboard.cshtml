@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-5">
    <!-- Dashboard heading -->
    <div class="mb-5">
        <p class="text-uppercase fw-bold"
           style="color:#80B900; letter-spacing:3px;">
            RACEDAY MANAGEMENT
        </p>

        <h1 class="fw-bold display-5">
            Organiser Dashboard<span style="color:#B7FF35;">.</span>
        </h1>

        <p class="text-muted">
            Manage your events, participants and race results.
        </p>
    </div>

    <!-- Dashboard summary -->
    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="p-4 rounded-3"
                 style="background:#171717; color:#F5F1E8;">
                <h6>EVENT MANAGEMENT</h6>
                <h3 class="fw-bold">Manage Events</h3>
                <p>Create, update and delete running events.</p>
                <span style="color:#B7FF35;">01 / EVENTS</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="p-4 rounded-3"
                 style="background:#FFFFFF; color:#171717;">
                <h6>CATEGORY MANAGEMENT</h6>
                <h3 class="fw-bold">Categories</h3>
                <p>Manage race distances and entry fees.</p>
                <span style="color:#80B900;">02 / CATEGORIES</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="p-4 rounded-3"
                 style="background:#B7FF35; color:#171717;">
                <h6>PARTICIPANT MANAGEMENT</h6>
                <h3 class="fw-bold">Enrolments</h3>
                <p>View participants enrolled in your events.</p>
                <span>03 / ENROLMENTS</span>
            </div>
        </div>

    </div>

    <!-- Management sections -->
    <h3 class="fw-bold mb-4">MANAGEMENT CENTRE</h3>

    <div class="row g-3">

        <div class="col-md-6">
            <div class="p-4 border rounded-3">
                <h4 class="fw-bold">Event Management</h4>
                <p>Create new events or update existing ones.</p>
                <a asp-controller="Organiser"
                   asp-action="Events"
                   class="btn btn-dark">
                    Manage Events
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-4 border rounded-3">
                <h4 class="fw-bold">Race Categories</h4>
                <p>Manage categories for your events.</p>
                <a asp-controller="Organiser"
                   asp-action="Categories"
                   class="btn btn-dark">
                    Manage Categories
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-4 border rounded-3">
                <h4 class="fw-bold">Event Enrolments</h4>
                <p>View participants registered for your events.</p>
                <a asp-controller="Organiser"
                   asp-action="Enrolments"
                   class="btn btn-dark">
                    View Enrolments
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-4 border rounded-3">
                <h4 class="fw-bold">Race Results</h4>
                <p>Enter and manage participant race results.</p>
                <a asp-controller="Organiser"
                   asp-action="Results"
                   class="btn btn-dark">
                    Manage Results
                </a>
            </div>
        </div>

    </div>
</div>
